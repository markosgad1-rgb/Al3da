rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tools/{toolCode} {
      allow read, write: if true;
    }
    match /technicians/{techId} {
      allow read, write: if true;
    }
    match /sites/{siteId} {
      allow read, write: if true;
    }
    match /transactions/{txId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
